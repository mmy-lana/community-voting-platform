{
  "name": "community-voting-platform",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "predev": "docker compose -p cvp -f docker/docker-compose.yml up -d --wait db",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:init": "cd backend && ../.venv/bin/python manage.py migrate",
    "db:migrate": "cd backend && ../.venv/bin/python manage.py migrate",
    "db:seed": "cd backend && ../.venv/bin/python manage.py seed_polls"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0",
    "turbo": "latest"
  }
}
