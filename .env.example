# Database (Neon Postgres connection string with pooler)
DATABASE_URL=postgres://voting_user:voting_password@localhost:5402/voting_db?sslmode=require

# Application Secrets
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
VOTE_HASH_SALT=dev_pepper_salt_for_voter_ip_hashing
SEED_VOTE_SALT=dev_deterministic_seed_salt_for_fixtures

# Networking & Ports
PORT_FE=5102
PORT_BE=8102
PORT_DB=5402
CORS_ORIGINS=http://localhost:5102,http://127.0.0.1:5102

# Server Configuration
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend
